[Unit]
Description=ComplyOS upcoming-expiry recertification reminder
Documentation=README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/complyos/complyos.env
WorkingDirectory=/opt/complyos
ExecStart=/opt/complyos/.venv/bin/complyos notifications expiring-soon --db /var/lib/complyos/complyos.db --json
User=complyos
Group=complyos
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/complyos

[Install]
WantedBy=multi-user.target
